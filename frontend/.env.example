# Kosongkan untuk memakai fallback Leaflet + tile gelap CARTO (demo tetap jalan)
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (vector, dark) dari Google Cloud Console. Opsional.
VITE_GOOGLE_MAP_ID=
# Opsional: URL tile untuk fallback Leaflet. Default CARTO dark_all (gratis, tanpa key, jalan di domain mana pun).
VITE_TILE_URL=
