# Kosongkan untuk memakai fallback Leaflet + tile gelap CARTO (demo tetap jalan)
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (vector, dark) dari Google Cloud Console. Opsional.
VITE_GOOGLE_MAP_ID=
# Opsional: URL tile untuk fallback Leaflet. Default Stadia alidade_smooth_dark (gratis, tanpa key di localhost).
VITE_TILE_URL=
