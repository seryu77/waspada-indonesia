<bpmn:sequenceFlow id="f13" name="" sourceRef="d_cs" targetRef="t_reply"/>
<bpmn:sequenceFlow id="f14" name="" sourceRef="t_reply" targetRef="d_gw2"/>
<bpmn:sequenceFlow id="f15" name="Ya" sourceRef="d_gw2" targetRef="d_rep"/>
<bpmn:sequenceFlow id="f16" name="Tidak" sourceRef="d_gw2" targetRef="m_coll"/>
<bpmn:sequenceFlow id="f17" name="" sourceRef="d_rep" targetRef="t_inv"/>
<bpmn:sequenceFlow id="f18" name="" sourceRef="t_inv" targetRef="m_coll"/>
<bpmn:sequenceFlow id="f19" name="" sourceRef="m_coll" targetRef="t_recv"/>
<bpmn:sequenceFlow id="f20" name="" sourceRef="t_recv" targetRef="d_end"/>
</bpmn:process><bpmndi:BPMNDiagram id="D"><bpmndi:BPMNPlane id="P" bpmnElement="Collab">
