<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://temanlunas.com/bpmn">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Cara Kerja Teman Lunas" processRef="Proc"/></bpmn:collaboration>
<bpmn:process id="Proc" isExecutable="false"><bpmn:laneSet id="LS">
<bpmn:lane id="Lane_S" name="Penjual Utang (Bank / Fintech / Multifinance)">
<bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_hub</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_no</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_paid</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_T" name="Teman Lunas (Pembeli &amp; Pemilik Piutang)">
<bpmn:flowNodeRef>t_dd</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_offer</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_gw1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_buy</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_pick</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_reply</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_inv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_M" name="Mitra Penagihan (Agensi berlisensi)">
<bpmn:flowNodeRef>m_contact</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_coll</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_D" name="Debitur (Nasabah)">
<bpmn:flowNodeRef>d_recv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>d_gw1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>d_fake</bpmn:flowNodeRef>
<bpmn:flowNodeRef>d_cs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>d_gw2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>d_rep</bpmn:flowNodeRef>
<bpmn:flowNodeRef>d_end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s_start" name="Punya portofolio kredit macet (NPL)"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="s_hub" name="Hubungi tim kemitraan, ceritakan portofolio"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_dd" name="Due diligence portofolio"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_offer" name="Berikan penawaran harga"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="t_gw1" name="Penjual setuju?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="s_no" name="Tanpa transaksi"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="t_buy" name="Beli portofolio dalam satu transaksi, piutang berpindah"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="s_paid" name="Harga beli diterima, keluar bersih"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="t_pick" name="Tetapkan strategi, tugaskan mitra berlisensi"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:task id="m_contact" name="Hubungi debitur sesuai kode etik dan aturan OJK"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
<bpmn:task id="d_recv" name="Terima pesan, cek identitas petugas, jangan bagikan OTP/PIN"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="d_gw1" name="Pesan resmi?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="d_fake" name="Abaikan dan laporkan penipuan"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="d_cs" name="Hubungi Customer Service lewat kanal resmi (tiket)"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_reply" name="CS membalas maks 1x24 jam kerja, cari solusi sesuai kondisi"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="d_gw2" name="Ada keluhan perilaku petugas?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="d_rep" name="Lapor lewat formulir Kontak"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_inv" name="Periksa laporan bersama mitra"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:task>
<bpmn:task id="m_coll" name="Tagih sesuai kesepakatan (desk / lapangan)"><bpmn:incoming>f16</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_recv" name="Terima dana tertagih, bersih komisi mitra"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="d_end" name="Kewajiban selesai, kembali ke kehidupan finansial"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f0" name="" sourceRef="s_start" targetRef="s_hub"/>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s_hub" targetRef="t_dd"/>
