# Semua opsional. Tanpa nilai apa pun, demo tetap jalan (verifier simulasi, dispatch simulasi).

# LLM (Claude). Kosong = verifier heuristik berlabel "simulasi"
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
VERIFY_MODEL=claude-opus-5-5
VERIFY_EFFORT=low

# NASA FIRMS (titik panas satelit). Daftar gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Dispatch 112: simulate (default, tidak pernah menelepon) atau webhook
DISPATCH_MODE=simulate
DISPATCH_WEBHOOK_URL=
DISPATCH_COUNTDOWN_S=45
# Confidence >= nilai ini: auto-dispatch (hitung mundur). Di bawahnya: tunggu validasi operator
DISPATCH_CONFIDENCE_MIN=0.87

# Mode demo: seed data + simulator kejadian baru tiap 20-30 detik
DEMO_MODE=true
SIMULATOR_MIN_S=20
SIMULATOR_MAX_S=30

# Sumber data nyata (gratis tanpa key, matikan kalau offline)
ENABLE_BMKG=true
ENABLE_PETABENCANA=true
ENABLE_MAGMA=true

# Pipeline CCTV + YOLO (butuh: pip install -r requirements-vision.txt)
ENABLE_VISION=false
VISION_SAMPLE_S=5
FIRE_WEIGHTS=weights/fire_smoke.pt
GENERAL_WEIGHTS=yolo11n.pt

# URL publik backend, dipakai untuk link frame bukti di payload dispatch
PUBLIC_BASE_URL=http://localhost:8000
