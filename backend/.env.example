# Semua opsional. Tanpa nilai apa pun, demo tetap jalan (verifier simulasi, dispatch simulasi).

# LLM verifier: Qwen3-VL lewat API chat kompatibel OpenAI.
# QWEN_BASE_URL kosong = verifier heuristik berlabel "simulasi".
# Lokal (Ollama): QWEN_BASE_URL=http://localhost:11434/v1, model qwen3-vl:4b, API key kosong
# Hugging Face: QWEN_BASE_URL=https://router.huggingface.co/v1, model Qwen/Qwen3-VL-8B-Instruct, API key = token HF
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_TRIAGE_MODEL=qwen3-vl:4b
QWEN_VERIFY_MODEL=qwen3-vl:4b
QWEN_TIMEOUT_S=120

# NASA FIRMS (titik panas satelit untuk heatmap kebakaran). Daftar gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Kosong = heatmap memakai data contoh (mode demo)
NASA_FIRMS_MAP_KEY=

# Dispatch 112: simulate (default, tidak pernah menelepon) atau webhook
DISPATCH_MODE=simulate
DISPATCH_WEBHOOK_URL=
DISPATCH_COUNTDOWN_S=45
# Confidence >= nilai ini: auto-dispatch (hitung mundur). Di bawahnya: tunggu validasi operator
DISPATCH_CONFIDENCE_MIN=0.87

# Mode demo: seed data + simulator kejadian baru tiap 20-30 detik
DEMO_MODE=true
SIMULATOR_MIN_S=20
SIMULATOR_MAX_S=30

# Sumber data nyata (gratis tanpa key, matikan kalau offline)
ENABLE_BMKG=true
ENABLE_PETABENCANA=true
ENABLE_MAGMA=true

# Pipeline CCTV + YOLO (butuh: pip install -r requirements-vision.txt)
ENABLE_VISION=false
VISION_SAMPLE_S=20
VISION_CONCURRENCY=3
# Batasi ke kota tertentu supaya laptop kuat, kosong = semua kamera ATCS
VISION_CITIES=
VISION_MAX_CAMERAS=0
# YOLO-World (prompt teks) untuk api, asap, banjir, kendaraan terguling. Kosongkan untuk mematikan.
WORLD_WEIGHTS=yolov8s-worldv2.pt
FIRE_WEIGHTS=weights/fire_smoke.pt
GENERAL_WEIGHTS=yolo11n.pt

# URL publik backend, dipakai untuk link frame bukti di payload dispatch
PUBLIC_BASE_URL=http://localhost:8000
